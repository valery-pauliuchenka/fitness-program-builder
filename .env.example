# Copy to .env for your own reference, then EXPORT the variables in the shell
# you launch `claude` from. Claude Code does not read .env files by itself.
#
#   macOS/Linux:  export MUSCLESWORKED_API_KEY="mw_live_..."
#   Windows (PowerShell):  $env:MUSCLESWORKED_API_KEY = "mw_live_..."
#
# API key for the musclesworked MCP server (https://musclesworked.com/dashboard).
MUSCLESWORKED_API_KEY=

# Optional: override the musclesworked API base URL.
# MUSCLESWORKED_API_URL=https://musclesworked.com
